# Ignore dependencies (let Docker install them inside the container)
node_modules
npm-debug.log*

# Ignore environment variables and secrets
.env
.env.*
!.env.example

# Ignore Git
.git
.gitignore

# Ignore Docker-specific files
Dockerfile*
.dockerignore

# Ignore test suites and test coverage
tests
coverage

# Ignore documentation & markdown files
README.md
*.md

# Ignore IDE and editor configurations
.vscode
.idea
*.sublime-project
*.sublime-workspace

# Ignore OS-generated files
.DS_Store
Thumbs.db
